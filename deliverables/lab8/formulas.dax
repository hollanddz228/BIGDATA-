// Әр формуланы Power BI ішіне БӨЛЕК енгізіңіз.
// Кестелер: Purchase, Centre, Town, Region; екінші есепте Brexit және Regions.
// Орысша интерфейс: Моделирование -> Создать столбец / Создать меру.

// 1-бөлім: New column
UK town = TRIM(Town[TownName]) & ", UK"

// 1-бөлім: New measure
TotalQuantity = SUM(Purchase[Quantity])

// 2-бөлім: New column. Format = Percentage, 2 decimal places.
PercentLeave = DIVIDE(Brexit[Leave], Brexit[Valid_Votes])

// 2-бөлім: үш бөлек New measure
TotalLeave = SUM(Brexit[Leave])

TotalValidVotes = SUM(Brexit[Valid_Votes])

LeaveShare = DIVIDE([TotalLeave], [TotalValidVotes])

// 2-бөлім: New column, Brexit кестесінде.
// Regions[Region] -> Brexit[Region] белсенді 1:* байланысын алдымен жасаңыз.
// Нақты деректе Gibraltar South West аймағына кіреді; карта үшін бөлек өңделеді.
MapCountry =
IF(
    Brexit[Area_Code] = "GI",
    "Gibraltar",
    RELATED(Regions[Country])
)

// Қосымша аудандық карта: New column. Алдымен MapCountry жасаңыз.
AreaCountry =
IF(
    Brexit[Area_Code] = "GI",
    "Gibraltar",
    Brexit[Area] & ", " & Brexit[MapCountry] & ", United Kingdom"
)
